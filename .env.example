# Copy to .env and replace every placeholder. Never commit .env.
# All values below are deliberately fake.

NODE_ENV=development
PORT=3000

# Cash Receipt (and any future money/stock posting) uses MongoDB transactions,
# which require a replica set. Atlas clusters already are one; for a local
# mongod, start it with --replSet rs0 and run rs.initiate() once.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>

# Must be at least 32 characters each, and different from each other.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-me
JWT_REFRESH_EXPIRES_IN=7d

COOKIE_DOMAIN=
# One of: lax | strict | none
COOKIE_SAME_SITE=lax

CORS_ORIGIN=http://localhost:3001

# --- File storage -------------------------------------------------------
# Switching providers = write one adapter class + change STORAGE_DRIVER.
# Files are always private: reads stream through GET /files/:id, never a provider URL.
STORAGE_DRIVER=mega
STORAGE_MAX_FILE_SIZE_MB=10

# Required when STORAGE_DRIVER=mega (validated at startup).
# Use a dedicated account WITHOUT two-factor auth: unattended login can't answer a 2FA prompt.
MEGA_EMAIL=app@example.com
MEGA_PASSWORD=changeme
# Top-level Cloud Drive folder; created on first use if it doesn't exist.
MEGA_FOLDER_NAME=ala-dates-files

# Required when STORAGE_DRIVER=r2 (uncomment and fill in).
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_REGION=auto
# R2_BUCKET=<bucket-name>
# R2_ACCESS_KEY_ID=<access-key-id>
# R2_SECRET_ACCESS_KEY=<secret-access-key>

# --- Local dev only -----------------------------------------------------
# Read only by `pnpm seed:dev-user` to create a local admin login.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme
